                    Designed with <span class="lts-heart">♥</span> by
                    <a href="https://www.linkedin.com/in/hajarnadioui/" target="_blank" rel="noopener" class="lts-footer-author">Hajar Nadioui</a>
                </p>
            </div>
        </div>
    </footer>

    <!-- ════════════════════════════════════════════════════
         AI CHATBOT BUBBLE
    ════════════════════════════════════════════════════ -->
    {{# showchatbot }}
    <div id="lts-chatbot-root"
         data-apikey="{{{ geminiapikey }}}"
         data-avatarurl="{{# hasaiavatar }}{{{ aiavatarimageurl }}}{{/ hasaiavatar }}"
         aria-live="polite">

        <!-- Toggle Button -->
        <button class="lts-chat-toggle" id="lts-chat-toggle" aria-label="Ouvrir l'assistant IA" aria-expanded="false">
            <div class="lts-chat-toggle-ring" aria-hidden="true"></div>
            {{# hasaiavatar }}
            <img src="{{{ aiavatarimageurl }}}" alt="AI" class="lts-chat-avatar-img" id="lts-toggle-avatar" width="54" height="54">
            {{/ hasaiavatar }}
            {{^ hasaiavatar }}
            <div class="lts-chat-default-avatar" id="lts-toggle-avatar" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="1.5"><path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2z"/></svg>
            </div>
            {{/ hasaiavatar }}
            <span class="lts-chat-badge" id="lts-chat-badge" aria-hidden="true"></span>
        </button>

        <!-- Chat Window -->
        <div class="lts-chat-window" id="lts-chat-window" role="dialog" aria-label="Assistant IA LTS Academy" aria-modal="true">

            <!-- Header -->
            <div class="lts-chat-header">
                <div class="lts-chat-header-left">
                    <div class="lts-chat-header-avatar-wrap">
                        {{# hasaiavatar }}
                        <img src="{{{ aiavatarimageurl }}}" alt="AI" class="lts-chat-header-avatar" width="40" height="40">
                        {{/ hasaiavatar }}
                        {{^ hasaiavatar }}
                        <div class="lts-chat-header-avatar lts-chat-header-avatar-default">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5"><path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2z"/></svg>
                        </div>
                        {{/ hasaiavatar }}
                        <span class="lts-chat-status-ring"></span>
                    </div>
                    <div class="lts-chat-header-info">
                        <h4 class="lts-chat-name">Assistant LTS Academy</h4>
                        <div class="lts-chat-status">
                            <span class="lts-status-dot"></span>
                            <span>En ligne · Propulsé par Gemini</span>
                        </div>
                    </div>
                </div>
                <button class="lts-chat-minimize" id="lts-chat-minimize" aria-label="Réduire le chat">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
            </div>

            <!-- Messages -->
            <div class="lts-chat-messages" id="lts-chat-messages" role="log" aria-live="polite" aria-atomic="false">
                <!-- Quick Questions (shown initially) -->
                <div class="lts-quick-questions" id="lts-quick-questions">
                    <p class="lts-quick-label">
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                        Questions fréquentes
                    </p>
                    <button class="lts-quick-btn" data-question="Quelles formations proposez-vous ?" id="quick-q1">Quelles formations proposez-vous ?</button>
                    <button class="lts-quick-btn" data-question="Comment s'inscrire à une formation ?" id="quick-q2">Comment s'inscrire à une formation ?</button>
                    <button class="lts-quick-btn" data-question="Quels sont les modes de formation disponibles ?" id="quick-q3">Modes de formation disponibles ?</button>
                    <button class="lts-quick-btn" data-question="Comment obtenir un devis personnalisé ?" id="quick-q4">Obtenir un devis personnalisé ?</button>
                </div>
            </div>

            <!-- Input Area -->
            <div class="lts-chat-input-area">
                <div class="lts-chat-input-wrap" id="lts-chat-input-wrap">
                    <textarea id="lts-chat-input" placeholder="Posez votre question…" rows="1" aria-label="Message" maxlength="1000"></textarea>
                    <button class="lts-chat-send" id="lts-chat-send" aria-label="Envoyer" disabled>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
                    </button>
                </div>
                <p class="lts-chat-footer-note">
                    <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    Vos données sont sécurisées
                </p>
            </div>
        </div>
    </div>
    {{/ showchatbot }}

</div><!-- /page-wrapper -->

{{{ output.standard_end_of_body_html }}}

<script>
// Pass data to JS modules via global config.
window.ltsAcademyConfig = {
    apiKey: '{{{ geminiapikey }}}',
    contactUrl: '{{{ contacturl }}}',
    sesskey: '{{{ sesskey }}}'
};
</script>

</body>
</html>
